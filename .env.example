# RMS AI — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Google Gemini API Key (required for AI features)
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Admin dashboard password (choose something strong)
ADMIN_PASSWORD=choose_a_strong_password

# Flask session secret key (auto-generated on Render, set manually for local dev)
SECRET_KEY=your_random_secret_key_here

# Database URL (leave empty for SQLite locally, set to PostgreSQL URL on Render)
# DATABASE_URL=postgresql://user:password@host:port/dbname
